{
  "name": "skl-x",
  "version": "0.4.3",
  "description": "Audit and manage AI agent skills for Claude Code and Codex",
  "license": "MIT",
  "author": "ihororlovskyi",
  "homepage": "https://github.com/sentimony/skl-x#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sentimony/skl-x.git"
  },
  "bugs": {
    "url": "https://github.com/sentimony/skl-x/issues"
  },
  "keywords": [
    "cli",
    "ai",
    "ai-agents",
    "agent-skills",
    "skills",
    "skills-lock",
    "claude",
    "claude-code",
    "codex",
    "audit",
    "usage",
    "token-cost"
  ],
  "type": "module",
  "bin": {
    "skl-x": "dist/cli.js",
    "skl": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && ~/.bun/bin/bun run node_modules/.bin/bunup",
    "lint": "biome check src/",
    "format": "biome format --write src/",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "prepublishOnly": "biome check src/ && vitest run && rm -rf dist && ~/.bun/bin/bun run node_modules/.bin/bunup && vitest run --config vitest.e2e.config.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^4.1.10",
    "bunup": "^0.16.32",
    "citty": "^0.2.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
